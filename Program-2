#include <stdio.h>
int main() {
    int n, i;
    int patients[100];
    int max, min, maxHour;
    int aboveAverage = 0;
    float sum = 0, average;
    printf("Enter number of hours: ");
    scanf("%d", &n);
    printf("Enter number of patients for each hour:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &patients[i]);
        sum += patients[i];
    }
    average = sum / n;
    max = patients[0];
    min = patients[0];
    maxHour = 0;
    for (i = 0; i < n; i++) {
        if (patients[i] > max) {
            max = patients[i];
            maxHour = i;
        }
        if (patients[i] < min) {
            min = patients[i];
        }
        if (patients[i] > average) {
            aboveAverage++;
        }
    }
    printf("\nMaximum patients = %d\n", max);
    printf("Peak hour = %d\n", maxHour + 1);
    printf("Minimum patients = %d\n", min);
    printf("Average patients = %.2f\n", average);
    printf("Hours above average = %d\n", aboveAverage);
    return 0;
}
