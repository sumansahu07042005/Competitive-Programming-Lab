#include <stdio.h>
int main() {
    int n, i, below = 0, position = 0;
    float attendance[100], threshold;
    float lowest, sum = 0, average;

    printf("Enter number of students: ");
    scanf("%d", &n);

    printf("Enter attendance percentages:\n");
    for (i = 0; i < n; i++) {
        scanf("%f", &attendance[i]);
        sum += attendance[i];
    }
    printf("Enter threshold: ");
    scanf("%f", &threshold);
    lowest = attendance[0];
    for (i = 0; i < n; i++) {
        if (attendance[i] < threshold)
            below++;
        if (attendance[i] < lowest) {
            lowest = attendance[i];
            position = i;
        }
    }
    average = sum / n;
    printf("\nStudents below threshold = %d\n", below);
    printf("Lowest attendance = %.2f%%\n", lowest);
    printf("Position = %d\n", position + 1);
    printf("Average attendance = %.2f%%\n", average);
    return 0;
}
